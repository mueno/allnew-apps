{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 scripts/build_public_site.py",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/pet-health-cards",
      "destination": "/hikae-cards/",
      "permanent": true
    },
    {
      "source": "/pet-health-cards/:path*",
      "destination": "/hikae-cards/:path*",
      "permanent": true
    },
    {
      "source": "/meishibridge",
      "destination": "/meishi-scanner/",
      "permanent": true
    },
    {
      "source": "/meishibridge/",
      "destination": "/meishi-scanner/",
      "permanent": true
    },
    {
      "source": "/feedback",
      "destination": "/feedback/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self' 'unsafe-inline' https://cdn.vercel-insights.com https://appleid.cdn-apple.com https://itunes.apple.com https://static.cloudflareinsights.com; img-src 'self' https://appleid.cdn-apple.com https://apps.allnew.work https://is1-ssl.mzstatic.com https://*.mzstatic.com data:; connect-src 'self' https://va.vercel-scripts.com https://appleid.apple.com https://apps.allnew.work https://allnew-mobile-baas.vercel.app https://itunes.apple.com; frame-src https://appleid.apple.com; object-src 'none'; base-uri 'self'; form-action 'self' https://appleid.apple.com; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/feedback/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://appleid.cdn-apple.com https://cdn.vercel-insights.com https://itunes.apple.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https://appleid.cdn-apple.com https://apps.allnew.work https://is1-ssl.mzstatic.com https://*.mzstatic.com; connect-src 'self' https://appleid.apple.com https://apps.allnew.work https://allnew-mobile-baas.vercel.app https://itunes.apple.com https://va.vercel-scripts.com; frame-src https://appleid.apple.com; object-src 'none'; base-uri 'self'; form-action 'self' https://appleid.apple.com; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "unsafe-none"
        }
      ]
    },
    {
      "source": "/(.*\\.md)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/internal/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/.planning/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/test-results/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/scripts/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/landing-automation/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "routes": [
    {
      "src": "(?i)/.*\\.md$",
      "status": 404,
      "headers": { "X-Robots-Tag": "noindex, nofollow", "Cache-Control": "no-store" }
    },
    {
      "src": "(?i)/internal(/.*)?$",
      "status": 404,
      "headers": { "X-Robots-Tag": "noindex, nofollow", "Cache-Control": "no-store" }
    },
    {
      "src": "(?i)/\\.planning(/.*)?$",
      "status": 404,
      "headers": { "X-Robots-Tag": "noindex, nofollow", "Cache-Control": "no-store" }
    },
    {
      "src": "(?i)/test-results(/.*)?$",
      "status": 404,
      "headers": { "X-Robots-Tag": "noindex, nofollow", "Cache-Control": "no-store" }
    },
    {
      "src": "(?i)/scripts(/.*)?$",
      "status": 404,
      "headers": { "X-Robots-Tag": "noindex, nofollow", "Cache-Control": "no-store" }
    },
    {
      "src": "(?i)/landing-automation/(?!runtime/landing-runtime\\.js$).*$",
      "status": 404,
      "headers": { "X-Robots-Tag": "noindex, nofollow", "Cache-Control": "no-store" }
    }
  ]
}
